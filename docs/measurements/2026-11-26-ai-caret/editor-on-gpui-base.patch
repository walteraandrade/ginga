+    /// Where the AI caret is drawn this frame, in the pane: on its way from
+    /// the writer's caret or from its last place in the text.
+    fn glide_ai_caret(
+        &mut self,
+        pos: usize,
+        bounds: Bounds<Pixels>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> Point<Pixels> {
         let origin = self.origin();
+        let spot = |bounds: Bounds<Pixels>| {
+            let place = bounds.origin - origin;
+            (f32::from(place.x), f32::from(place.y))
+        };
+        let takeoff = if cx.reduce_motion() {
+            None
+        } else {
+            let editor = self.editor.read(cx);
+            let head = editor.cursor();
+            editor.range_to_bounds(&(head..head)).map(spot)
+        };
+        let leg = self.ai_caret_travel.step(pos, spot(bounds), takeoff);
+        let covered = ui::travel(
+            ("ai-caret", leg.flight),
+            point(px(leg.travelled.0), px(leg.travelled.1)),
+            window,
+            cx,
+        );
+        if leg.taking_off {
+            window.request_animation_frame();
+        }
+        let (left, top) = leg.drawn_at((f32::from(covered.x), f32::from(covered.y)));
+        point(px(left), px(top))
+    }
+
