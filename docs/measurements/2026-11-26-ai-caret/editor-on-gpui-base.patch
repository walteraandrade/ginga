+/// How much of `travelled` a traveller has covered this frame. When the total
+/// changes it heads for the new one from wherever it is, and it asks for
+/// frames until it gets there.
+pub fn travel(
+    id: impl Into<ElementId>,
+    travelled: Point<Pixels>,
+    window: &mut Window,
+    cx: &mut App,
+) -> Point<Pixels> {
+    gpui_kit::base::motion::transition(
+        (id, "travel"),
+        travelled,
+        gpui_kit::base::motion::Transition::new(MOTION_TRAVEL).ease(ease_out_expo),
+        window,
+        cx,
+    )
+}
